# Backend Environment Variables
# Copy this file to .env and fill in your values

# --- LOCAL DEV ---
# SQLite (no external service needed)
# DATABASE_URL="file:../prisma/dev.db"

# --- PRODUCTION (Render + Neon) ---
# PostgreSQL from Neon (copy connection string from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/trademind?sslmode=require"

# JWT secret — use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET="your_super_secret_jwt_key_change_in_production"

# Server port (Render injects this automatically)
PORT=5000

# Your Vercel frontend URL — set this in Render's environment variables
FRONTEND_URL="https://your-app.vercel.app"
